DATA: 
    
    FILE = "../datasets/align_strata12_eth_pov.csv"; ! folder where Mplus datasets have been stored

VARIABLE:

    NAMES = 
        ID pttype2 sptn00 hovwt2 
        birthsex ethnicity sexuality poverty strata
        k6_1 k6_2 k6_3 k6_4 k6_5 k6_6
        sw_1 sw_2 sw_3 sw_4 sw_5 sw_6 sw_7
        sh_1 sh_2 sh_3 sh_4 sh_5 sh_6;
       
    IDVARIABLE = ID;

    USEVARIABLES = 
        sw_1-sw_7
        strata;

    MISSING = ALL (-9999);

    CLASSES = c(11);
    
    KNOWNCLASS = c(strata = 
        10 20 30 40 50 60
        11 21 31 41 51   );

    STRATIFICATION = pttype2;
    WEIGHT = hovwt2;
    CLUSTER = sptn00;

    ANALYSIS:
        
        TYPE = COMPLEX MIXTURE;
        ALIGNMENT = FIXED(10);
        PROCESSORS = 8;
        ALGORITHM = INTEGRATION;

    MODEL:

        %OVERALL%
        swemwbs BY sw_1-sw_7;

    OUTPUT:

        ALIGN;