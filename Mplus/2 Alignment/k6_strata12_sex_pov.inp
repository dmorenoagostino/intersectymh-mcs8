DATA: 
    
    FILE = "../datasets/20260611_align_strata4_sex_pov.csv";

VARIABLE:

    NAMES = 
        ID pttype2 sptn00 hovwt2 
        birthsex ethnicity sexuality poverty strata
        k6_1 k6_2 k6_3 k6_4 k6_5 k6_6
        sw_1 sw_2 sw_3 sw_4 sw_5 sw_6 sw_7
        sh_1 sh_2 sh_3 sh_4 sh_5 sh_6;
       
    IDVARIABLE = ID;

    USEVARIABLES = 
        k6_1-k6_6
        strata;

    MISSING = ALL (-9999);

    CLASSES = c(4);
    
    KNOWNCLASS = c(strata = 
        10 11
        20 21);

    STRATIFICATION = pttype2;
    WEIGHT = hovwt2;
    CLUSTER = sptn00;

    ANALYSIS:
        
        TYPE = COMPLEX MIXTURE;
        ALIGNMENT = FIXED(10);
        PROCESSORS = 8;
        ALGORITHM = INTEGRATION;

    MODEL:

        %OVERALL%
        k6 BY k6_1-k6_6;

    OUTPUT:

        ALIGN;