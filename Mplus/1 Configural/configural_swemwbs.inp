DATA: 
    
    FILE = "../datasets/align_strata1.csv"; ! folder where Mplus datasets have been stored

VARIABLE:

    NAMES = 
        ID pttype2 sptn00 hovwt2  
        female ethnicity sexuality poverty strata
        k6_1-k6_6
        sw_1-sw_7
        sh_1-sh_6;
        
    IDVARIABLE = ID;

    USEVARIABLES = 
        sw_1-sw_7;

    MISSING = ALL (-9999);

    STRATIFICATION = pttype2;
    WEIGHT = hovwt2;
    CLUSTER = sptn00;

    ANALYSIS:
        
        TYPE = COMPLEX;
        
    MODEL:

        sw BY sw_1-sw_7;


    OUTPUT:

        TECH1 STDYX;