DATA: 
    
    FILE = "../datasets/20260629_align_strata1.csv";

VARIABLE:

    NAMES = 
        ID pttype2 sptn00 hovwt2  
        female ethnicity sexuality poverty strata
        k6_1-k6_6
        sw_1-sw_7
        sh_1-sh_6;
        
    IDVARIABLE = ID;

    USEVARIABLES = 
        k6_1-k6_6;

    MISSING = ALL (-9999);

    STRATIFICATION = pttype2;
    WEIGHT = hovwt2;
    CLUSTER = sptn00;

    ANALYSIS:
        
        TYPE = COMPLEX;
        
    MODEL:

        k6 BY k6_1-k6_6;


    OUTPUT:

        TECH1 STDYX;