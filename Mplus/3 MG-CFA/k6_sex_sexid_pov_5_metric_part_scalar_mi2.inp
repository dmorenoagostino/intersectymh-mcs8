DATA: 
    
    FILE = "../datasets/align_strata8_sex_sexid_pov.csv"; ! folder where Mplus datasets have been stored

VARIABLE:

    NAMES = 
        ID pttype2 sptn00 hovwt2 
        birthsex ethnicity sexuality poverty strata
        k6_1-k6_6
        sw_1-sw_7
        sh_1-sh_6;
        
    IDVARIABLE = ID;

    USEVARIABLES = 
        k6_1-k6_6 strata;

    GROUPING = strata (
        100 = fem_0_0
        101 = fem_0_1
        110 = fem_1_0
        111 = fem_1_1
        200 = mal_0_0
        201 = mal_0_1
        210 = mal_1_0
        211 = mal_1_1
        );

    MISSING = ALL (-9999);

    STRATIFICATION = pttype2;
    WEIGHT = hovwt2;
    CLUSTER = sptn00;

    ANALYSIS:
        
        TYPE = COMPLEX;
        
    MODEL:

        k6 BY k6_5 k6_1 k6_2 k6_3 k6_4 k6_6; ! using item 5 as anchor based on YPAG input

        [k6_1];
        [k6_2];
        [k6_3];
        [k6_4];
        [k6_5];
        [k6_6];

        MODEL fem_0_0:
        
            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3) 
                k6_4 (l4) 
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6]  ;

            [k6@0];

        MODEL fem_0_1:

            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3)
                k6_4 (l4) 
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6] ;

            [k6];

        MODEL fem_1_0:

            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3) 
                k6_4 (l4) 
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6] (i6);

            [k6];

        MODEL fem_1_1:

            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3) 
                k6_4   
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6] (i6);

            [k6];

        MODEL mal_0_0:
        
            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3)  
                k6_4 (l4) 
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6] ;

            [k6];

        MODEL mal_0_1:

            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3) 
                k6_4 (l4) 
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6] ;

            [k6];

        MODEL mal_1_0:

            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3)  
                k6_4 (l4) 
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6] (i6);

            [k6];

        MODEL mal_1_1:

            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3)  
                k6_4 (l4) 
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6] (i6);

            [k6];

    OUTPUT:

        TECH1 STDYX;
        MODINDICES(15);
