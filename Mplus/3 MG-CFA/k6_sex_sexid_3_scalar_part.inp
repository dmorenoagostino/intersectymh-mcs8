DATA: 
    
    FILE = "../datasets/20260629_align_strata4_sex_sexid.csv";

VARIABLE:

    NAMES = 
        ID pttype2 sptn00 hovwt2 
        birthsex ethnicity sexuality poverty strata
        k6_1-k6_6
        sw_1-sw_7
        sh_1-sh_6;
        
    IDVARIABLE = ID;

    USEVARIABLES = 
        k6_1-k6_6 strata;

    GROUPING = strata (
        10 = fem_0
        11 = fem_1
        20 = mal_0
        21 = mal_1
        );

    MISSING = ALL (-9999);

    STRATIFICATION = pttype2;
    WEIGHT = hovwt2;
    CLUSTER = sptn00;

    ANALYSIS:
        
        TYPE = COMPLEX;

    MODEL:

        k6 BY k6_5 k6_1 k6_2 k6_3 k6_4 k6_6; ! using item 5 as anchor based on YPAG input

        [k6_1];
        [k6_2];
        [k6_3];
        [k6_4];
        [k6_5];
        [k6_6];

        MODEL fem_0:
        
            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3)
                k6_4 (l4)
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6];

            [k6@0];

        MODEL fem_1:

            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3)
                k6_4 (l4)
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6] (i6);

        MODEL mal_0:

            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3)
                k6_4 (l4)
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6];

        MODEL mal_1:

            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3)
                k6_4 (l4)
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6] (i6);


    OUTPUT:

        TECH1 STDYX;
        MODINDICES(20);

    SAVEDATA:

        FILE = 20260703_k6_sex_sexid_scalar_part_fscores.csv;
        SAVE = FSCORES;
