DATA: 
    
    FILE = "../datasets/20260611_align_strata4_sex_sexid.csv";

VARIABLE:

    NAMES = 
        ID pttype2 sptn00 hovwt2 
        birthsex ethnicity sexuality poverty strata
        k6_1-k6_6
        sw_1-sw_7
        sh_1-sh_6;
        
    IDVARIABLE = ID;

    USEVARIABLES = 
        sw_1-sw_7 strata;

    GROUPING = strata (
        10 = fem_0
        11 = fem_1
        20 = mal_0
        21 = mal_1
        );

    MISSING = ALL (-9999);

    STRATIFICATION = pttype2;
    WEIGHT = hovwt2;
    CLUSTER = sptn00;

    ANALYSIS:
        
        TYPE = COMPLEX;
        
    MODEL:

        sw BY sw_3 sw_1 sw_2 sw_4-sw_7; ! using item 3 as anchor based on YPAG input

        [sw_1];
        [sw_2];
        [sw_3];
        [sw_4];
        [sw_5];
        [sw_6];
        [sw_7];

        MODEL fem_0:
        
            sw BY 
                sw_1 (l1)
                sw_2 (l2)
                sw_3 (l3)
                sw_4 (l4)
                sw_5 (l5)
                sw_6 (l6)
                sw_7 (l7);

            [sw_1] (i1);
            [sw_2] (i2);
            [sw_3] (i3);
            [sw_4] (i4);
            [sw_5] (i5);
            [sw_6] (i6);
            [sw_7] (i7);

            sw@1;
            [sw@0];

        MODEL fem_1:

            sw BY 
                sw_1 (l1)
                sw_2 (l2)
                sw_3 (l3)
                sw_4 (l4)
                sw_5 (l5)
                sw_6 (l6)
                sw_7 (l7);

            [sw_1] (i1);
            [sw_2] (i2);
            [sw_3] (i3);
            [sw_4] (i4);
            [sw_5] (i5);
            [sw_6] (i6);
            [sw_7] (i7);

        MODEL mal_0:

            sw BY 
                sw_1 (l1)
                sw_2 (l2)
                sw_3 (l3)
                sw_4 (l4)
                sw_5 (l5)
                sw_6 (l6)
                sw_7 (l7);

            [sw_1] (i1);
            [sw_2] (i2);
            [sw_3] (i3);
            [sw_4] (i4);
            [sw_5] (i5);
            [sw_6];
            [sw_7] (i7);

        MODEL mal_1:

            sw BY 
                sw_1 (l1)
                sw_2 (l2)
                sw_3 (l3)
                sw_4 (l4)
                sw_5 (l5)
                sw_6 (l6)
                sw_7 (l7);

            [sw_1] (i1);
            [sw_2] (i2);
            [sw_3] (i3);
            [sw_4] (i4);
            [sw_5] (i5);
            [sw_6] (i6);
            [sw_7] (i7);


    OUTPUT:

        TECH1 STDYX;
        MODINDICES(20);

    SAVEDATA:

        FILE = 20260611_swemwbs_sex_sexid_scalar_part_fscores.csv;
        SAVE = FSCORES;