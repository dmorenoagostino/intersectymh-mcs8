DATA: 
    
    FILE = "../datasets/align_strata8_sex_sexid_pov.csv"; ! folder where Mplus datasets have been stored

VARIABLE:

    NAMES = 
        ID pttype2 sptn00 hovwt2 
        birthsex ethnicity sexuality poverty strata
        k6_1-k6_6
        sw_1-sw_7
        sh_1-sh_6;
        
    IDVARIABLE = ID;

    USEVARIABLES = 
        sw_1-sw_7 strata;

    GROUPING = strata (
        100 = fem_0_0
        101 = fem_0_1
        110 = fem_1_0
        111 = fem_1_1
        200 = mal_0_0
        201 = mal_0_1
        210 = mal_1_0
        211 = mal_1_1
        );

    MISSING = ALL (-9999);

    STRATIFICATION = pttype2;
    WEIGHT = hovwt2;
    CLUSTER = sptn00;

    ANALYSIS:
        
        TYPE = COMPLEX;
        MODEL = SCALAR;
        
    MODEL:

        sw BY sw_3 sw_1 sw_2 sw_4-sw_7; ! using item 3 as anchor based on YPAG input

    OUTPUT:

        TECH1 STDYX;
        MODINDICES(20);