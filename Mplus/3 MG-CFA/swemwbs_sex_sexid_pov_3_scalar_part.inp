DATA: 
    
    FILE = "../datasets/align_strata8_sex_sexid_pov.csv"; ! folder where Mplus datasets have been stored

VARIABLE:

    NAMES = 
        ID pttype2 sptn00 hovwt2 
        birthsex ethnicity sexuality poverty strata
        k6_1-k6_6
        sw_1-sw_7
        sh_1-sh_6;
        
    IDVARIABLE = ID;

    USEVARIABLES = 
        sw_1-sw_7 strata;

    GROUPING = strata (
        100 = fem_0_0
        101 = fem_0_1
        110 = fem_1_0
        111 = fem_1_1
        200 = mal_0_0
        201 = mal_0_1
        210 = mal_1_0
        211 = mal_1_1
        );

    MISSING = ALL (-9999);

    STRATIFICATION = pttype2;
    WEIGHT = hovwt2;
    CLUSTER = sptn00;

    ANALYSIS:
        
        TYPE = COMPLEX;
        STARTS = 20;
        
    MODEL:

        sw BY sw_3 sw_1 sw_2 sw_4-sw_7; ! using item 3 as anchor based on YPAG input

        [sw_1];
        [sw_2];
        [sw_3];
        [sw_4];
        [sw_5];
        [sw_6];
        [sw_7];

        MODEL fem_0_0:
        
            sw BY 
                sw_1 (l1)
                sw_2 (l2)
                sw_3@1 (l3)
                sw_4 (l4)
                sw_5 (l5)
                sw_6 (l6)
                sw_7 (l7);

            [sw_1];
            [sw_2] (i2);
            [sw_3] (i3);
            [sw_4] (i4);
            [sw_5] (i5);
            [sw_6];
            [sw_7];

            [sw@0];

        MODEL fem_1_0:
        
            sw BY 
                sw_1 (l1)
                sw_2 (l2)
                sw_3@1 (l3)
                sw_4 (l4)
                sw_5 (l5)
                sw_6 (l6)
                sw_7 (l7);

            [sw_1] (i1);
            [sw_2] (i2);
            [sw_3] (i3);
            [sw_4] (i4);
            [sw_5] (i5);
            [sw_6] (i6);
            [sw_7] (i7);

        MODEL fem_0_1:
        
            sw BY 
                sw_1 (l1)
                sw_2 (l2)
                sw_3@1 (l3)
                sw_4 (l4)
                sw_5 (l5)
                sw_6 (l6)
                sw_7 (l7);

            [sw_1] (i1);
            [sw_2] (i2);
            [sw_3] (i3);
            [sw_4] (i4);
            [sw_5] (i5);
            [sw_6] (i6);
            [sw_7] (i7);

        MODEL fem_1_1:
        
            sw BY 
                sw_1 (l1)
                sw_2 (l2)
                sw_3@1 (l3)
                sw_4 (l4)
                sw_5 (l5)
                sw_6 (l6)
                sw_7 (l7);

            [sw_1] (i1);
            [sw_2] (i2);
            [sw_3] (i3);
            [sw_4] (i4);
            [sw_5] (i5);
            [sw_6] (i6);
            [sw_7] (i7);

        MODEL mal_0_0:
        
            sw BY 
                sw_1 (l1)
                sw_2 (l2)
                sw_3@1 (l3)
                sw_4 (l4)
                sw_5 (l5)
                sw_6 (l6)
                sw_7 (l7);

            [sw_1] (i1);
            [sw_2] (i2);
            [sw_3] (i3);
            [sw_4] (i4);
            [sw_5] (i5);
            [sw_6] (i6);
            [sw_7] (i7);

        MODEL mal_1_0:
        
            sw BY 
                sw_1 (l1)
                sw_2 (l2)
                sw_3@1 (l3)
                sw_4 (l4)
                sw_5 (l5)
                sw_6 (l6)
                sw_7 (l7);

            [sw_1] (i1);
            [sw_2] (i2);
            [sw_3] (i3);
            [sw_4] (i4);
            [sw_5] (i5);
            [sw_6] (i6);
            [sw_7] (i7);

        MODEL mal_0_1:
        
            sw BY 
                sw_1 (l1)
                sw_2 (l2)
                sw_3@1 (l3)
                sw_4 (l4)
                sw_5 (l5)
                sw_6 (l6)
                sw_7 (l7);

            [sw_1] (i1);
            [sw_2] (i2);
            [sw_3] (i3);
            [sw_4] (i4);
            [sw_5] (i5);
            [sw_6] (i6);
            [sw_7] (i7);

        MODEL mal_1_1:
        
            sw BY 
                sw_1 (l1)
                sw_2 (l2)
                sw_3@1 (l3)
                sw_4 (l4)
                sw_5 (l5)
                sw_6 (l6)
                sw_7 (l7);

            [sw_1] (i1);
            [sw_2] (i2);
            [sw_3] (i3);
            [sw_4] (i4);
            [sw_5] (i5);
            [sw_6] (i6);
            [sw_7] (i7);
          


    OUTPUT:

        TECH1 STDYX;
        MODINDICES(20);

    SAVEDATA:

        FILE = swemwbs_fscores.csv;  ! file where partially invariant factor scores will be saved
        SAVE = FSCORES;