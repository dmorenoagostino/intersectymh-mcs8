DATA: 
    
    FILE = "../datasets/20260629_align_strata4_sexid_pov.csv";

VARIABLE:

    NAMES = 
        ID pttype2 sptn00 hovwt2 
        birthsex ethnicity sexuality poverty strata
        k6_1-k6_6
        sw_1-sw_7
        sh_1-sh_6;
        
    IDVARIABLE = ID;

    USEVARIABLES = 
        k6_1-k6_6 strata;

    GROUPING = strata (
        0 = het_0
        1 = het_1
        10 = sm_0
        11 = sm_1
        );

    MISSING = ALL (-9999);

    STRATIFICATION = pttype2;
    WEIGHT = hovwt2;
    CLUSTER = sptn00;

    ANALYSIS:
        
        TYPE = COMPLEX;
        MODEL = CONFIGURAL METRIC SCALAR;
        
    MODEL:

        k6 BY k6_5 k6_1 k6_2 k6_3 k6_4 k6_6; ! using item 5 as anchor based on YPAG input

    OUTPUT:

        TECH1 STDYX;
        !MODINDICES(20);