DATA: 
    
    FILE = "../datasets/20260629_align_strata4_sexid_pov.csv";

VARIABLE:

    NAMES = 
        ID pttype2 sptn00 hovwt2 
        birthsex ethnicity sexuality poverty strata
        k6_1-k6_6
        sw_1-sw_7
        sh_1-sh_6;
        
    IDVARIABLE = ID;

    USEVARIABLES = 
        k6_1-k6_6 strata;

    GROUPING = strata (
        0 = het_0
        1 = het_1
        10 = sm_0
        11 = sm_1
        );

    MISSING = ALL (-9999);

    STRATIFICATION = pttype2;
    WEIGHT = hovwt2;
    CLUSTER = sptn00;

    ANALYSIS:
        
        TYPE = COMPLEX;
         
    MODEL:

        k6 BY k6_5 k6_1 k6_2 k6_3 k6_4 k6_6; ! using item 5 as anchor based on YPAG input

        [k6_1];
        [k6_2];
        [k6_3];
        [k6_4];
        [k6_5];
        [k6_6];

        MODEL het_0:
        
            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3)
                k6_4 (l4)
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6] (i6);

            [k6@0];

        MODEL het_1:

            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3)
                k6_4 (l4)
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6];

            [k6];

        MODEL sm_0:

            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3)
                k6_4 (l4)
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6] (i6);

            [k6];

        MODEL sm_1:

            k6 BY 
                k6_1 (l1)
                k6_2 (l2)
                k6_3 (l3)
                k6_4 
                k6_5@1 (l5)
                k6_6 (l6);

            [k6_1] (i1);
            [k6_2] (i2);
            [k6_3] (i3);
            [k6_4] (i4);
            [k6_5] (i5);
            [k6_6] (i6);

            [k6];

    OUTPUT:

        TECH1 STDYX;
        MODINDICES(20);