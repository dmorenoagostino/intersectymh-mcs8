DATA: 
    
    FILE = "../datasets/20260611_align_strata4_sex_pov.csv";

VARIABLE:

    NAMES = 
        ID pttype2 sptn00 hovwt2 
        birthsex ethnicity sexuality poverty strata
        k6_1-k6_6
        sw_1-sw_7
        sh_1-sh_6;
        
    IDVARIABLE = ID;

    USEVARIABLES = 
        sw_1-sw_7 strata;

    GROUPING = strata (
        10 = fem_0
        11 = fem_1
        20 = mal_0
        21 = mal_1
        );

    MISSING = ALL (-9999);

    STRATIFICATION = pttype2;
    WEIGHT = hovwt2;
    CLUSTER = sptn00;

    ANALYSIS:
        
        TYPE = COMPLEX;
        MODEL = CONFIGURAL METRIC SCALAR;
        
    MODEL:

        sw BY sw_3 sw_1 sw_2 sw_4-sw_7; ! using item 3 as anchor based on YPAG input

    OUTPUT:

        TECH1 STDYX;
        !MODINDICES(10);